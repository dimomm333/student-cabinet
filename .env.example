# Local SQLite file. Relative paths are resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# Run npm run auth:setup to generate the secret locally; never commit a real secret.
BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_SECRET=

# Default direct mode ignores all client-supplied IP headers; localhost only.
AUTH_TRUST_PROXY=false
# For an external HTTPS deployment set true and provision a random proxy secret.
# AUTH_PROXY_SECRET=

# Public REST API: per Node instance, fixed one-minute windows.
SCHEDULE_API_RATE_LIMIT=60
SCHEDULE_API_GLOBAL_LIMIT=600
SCHEDULE_API_CONCURRENCY=4
# Server cache lifetime (0 disables; maximum 60 seconds).
SCHEDULE_API_CACHE_SECONDS=15

# Optional: supply DEMO_ALEXANDER_PASSWORD, DEMO_MARIA_PASSWORD,
# DEMO_ADMIN_PASSWORD, DEMO_TEACHER_PASSWORD, DEMO_STAFF_PASSWORD,
# DEMO_DEANERY_PASSWORD via environment.
# Otherwise db:seed generates random passwords in ignored .env.demo.local.
