# Local SQLite file. Relative paths are resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# Private service attachments; provision as a separate non-public volume in production.
SERVICES_STORAGE_DIR=".local/service-documents"
PORTFOLIO_STORAGE_DIR=".local/portfolio-documents"

# Run npm run auth:setup to generate the secret locally; never commit a real secret.
BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_SECRET=

# Persistent server key for electronic passes. Generate an independent random secret (32+ characters).
# PASS_TOKEN_KEY=
# Enable sample marking when the whole environment contains synthetic data.
PASS_SAMPLE_MODE=false

# Default direct mode ignores all client-supplied IP headers; localhost only.
AUTH_TRUST_PROXY=false
# For an external HTTPS deployment set true and provision a random proxy secret.
# AUTH_PROXY_SECRET=

# Public REST API: per Node instance, fixed one-minute windows.
SCHEDULE_API_RATE_LIMIT=60
SCHEDULE_API_GLOBAL_LIMIT=600
SCHEDULE_API_CONCURRENCY=4
# Server cache lifetime (0 disables; maximum 60 seconds).
SCHEDULE_API_CACHE_SECONDS=15

# Optional notification SMTP adapter. Delivery is unavailable until configured.
# NOTIFICATIONS_SMTP_HOST=smtp.example.test
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_SECURE=false
# NOTIFICATIONS_SMTP_FROM=notifications@example.test
# NOTIFICATIONS_SMTP_USER=
# NOTIFICATIONS_SMTP_PASSWORD=
# Production requires HTTPS BETTER_AUTH_URL and validated TLS to SMTP.
# Only loopback test SMTP can explicitly disable TLS with this flag:
NOTIFICATIONS_SMTP_LOCAL_TEST=false

# Optional housing payment reminders generated by notifications:deliver.
# DORMITORY_PAYMENT_REMINDER_DAYS=3

# Optional: supply DEMO_ALEXANDER_PASSWORD, DEMO_MARIA_PASSWORD,
# DEMO_ADMIN_PASSWORD, DEMO_TEACHER_PASSWORD, DEMO_STAFF_PASSWORD,
# DEMO_DEANERY_PASSWORD via environment.
# Otherwise db:seed generates random passwords in ignored .env.demo.local.
# Private learning-material files (outside public/); per-file limit in MiB.
MATERIALS_STORAGE_DIR=.local/material-files
MATERIALS_MAX_FILE_MB=32
