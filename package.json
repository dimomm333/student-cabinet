{
  "name": "student-cabinet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "auth:setup": "node scripts/setup-auth-env.mjs",
    "auth:harden-sessions": "node --env-file-if-exists=.env scripts/harden-sessions.mjs",
    "test:auth": "node --env-file-if-exists=.env scripts/verify-auth.mjs",
    "test:auth:dev": "node --env-file-if-exists=.env scripts/verify-auth-security.mjs --development",
    "db:setup": "npm run db:generate && npm run db:deploy && npm run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.22",
    "dotenv": "17.2.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
