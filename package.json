{
  "name": "student-cabinet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "db:dormitory": "node --env-file-if-exists=.env scripts/prepare-clearance.mjs --dormitory",
    "demo:dormitory": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-dormitory.mjs --demo",
    "test:dormitory": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-dormitory.mjs",
    "test:dormitory:money": "node scripts/verify-dormitory-money.mjs",
    "test:dormitory:browser": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-dormitory.mjs --browser",
    "db:passes": "node --env-file-if-exists=.env scripts/prepare-clearance.mjs --passes --apply",
    "passes:grant": "node --env-file-if-exists=.env scripts/configure-pass-grant.mjs",
    "test:passes": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-passes.mjs",
    "db:clearance": "node --env-file-if-exists=.env scripts/prepare-clearance.mjs --apply",
    "clearance:configure": "node --env-file-if-exists=.env --conditions=react-server scripts/seed-clearance.mjs --configure-only --apply",
    "clearance:demo": "node --env-file-if-exists=.env --conditions=react-server scripts/seed-clearance.mjs",
    "test:clearance": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-clearance.mjs",
    "test:dashboard": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-dashboard.mjs",
    "db:dashboard": "node --env-file-if-exists=.env scripts/prepare-dashboard.mjs --apply",
    "db:brs:review": "node --env-file-if-exists=.env scripts/prepare-brs-finals.mjs --apply",
    "db:brs:grading": "node --env-file-if-exists=.env scripts/prepare-brs-grading.mjs --apply",
    "db:brs:refine": "node --env-file-if-exists=.env scripts/prepare-brs-primary.mjs --apply",
    "db:brs": "node --env-file-if-exists=.env scripts/prepare-brs.mjs --apply",
    "db:brs:seed": "node --env-file-if-exists=.env --conditions=react-server scripts/seed-brs.mjs",
    "test:brs": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-brs.mjs",
    "db:student-profile": "node --env-file-if-exists=.env scripts/prepare-student-profile.mjs --apply",
    "db:student-photo": "node --env-file-if-exists=.env scripts/set-student-photo.mjs",
    "test:student-photo": "node scripts/verify-student-photo.mjs",
    "test:schedule:bells": "node scripts/verify-schedule-bells.mjs",
    "test:schedule:editor": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-schedule-editor.mjs",
    "db:schedule-editor": "node --env-file-if-exists=.env scripts/prepare-schedule-editor.mjs --apply",
    "test:deanery": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-deanery.mjs",
    "db:deanery": "node --env-file-if-exists=.env scripts/prepare-deanery.mjs --apply",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "auth:setup": "node scripts/setup-auth-env.mjs",
    "auth:harden-sessions": "node --env-file-if-exists=.env scripts/harden-sessions.mjs",
    "test:auth": "node --env-file-if-exists=.env scripts/verify-auth.mjs",
    "test:auth:password": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-password-policy.mjs",
    "test:api": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-schedule-api.mjs",
    "test:auth:navigation": "node --env-file-if-exists=.env scripts/verify-cabinet-navigation.mjs",
    "test:themes": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-themes.mjs",
    "test:header": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-mobile-header.mjs",
    "test:schedule:browser": "node --env-file-if-exists=.env scripts/verify-schedule-browser.mjs",
    "test": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-schedule.mjs",
    "test:auth:dev": "node --env-file-if-exists=.env scripts/verify-auth-security.mjs --development",
    "db:setup": "npm run db:generate && npm run db:deploy && npm run db:seed",
    "db:services": "node --env-file-if-exists=.env scripts/prepare-services.mjs --apply",
    "db:services:seed": "node --env-file-if-exists=.env --conditions=react-server scripts/seed-services.mjs",
    "services:configure": "node --env-file-if-exists=.env --conditions=react-server scripts/configure-services.mjs",
    "test:services": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-services.mjs",
    "test:services:ui": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-services-ui.mjs",
    "test:portfolio": "node --env-file-if-exists=.env scripts/verify-portfolio.mjs",
    "db:notifications": "node --env-file-if-exists=.env scripts/prepare-notifications.mjs --apply",
    "notifications:deliver": "node --env-file-if-exists=.env --conditions=react-server scripts/deliver-notifications.mjs",
    "test:notifications": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-notifications.mjs",
    "db:materials": "node --env-file-if-exists=.env scripts/prepare-materials.mjs --apply",
    "test:materials": "node --env-file-if-exists=.env --conditions=react-server scripts/verify-materials.mjs"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "@zxcvbn-ts/language-en": "4.1.2",
    "better-auth": "1.7.22",
    "dotenv": "17.2.3",
    "jsqr": "1.4.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
