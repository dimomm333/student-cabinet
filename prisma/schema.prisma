generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

enum ClearanceReason {
  GRADUATION
  WITHDRAWAL
  TRANSFER
}

enum ClearanceStatus {
  DRAFT
  IN_PROGRESS
  ACTION_REQUIRED
  READY_FOR_FINAL_REVIEW
  COMPLETED
  CANCELLED
}

enum ClearanceStepStatus {
  PENDING
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  NOT_APPLICABLE
}

enum ClearanceRule {
  ALWAYS
  DORMITORY
  PAID
  EQUIPMENT
  GRADUATION
  MANUAL
  FINAL
}

model ClearanceDepartment {
  id          String                  @id @default(cuid())
  code        String                  @unique
  name        String
  description String
  contact     String
  active      Boolean                 @default(true)
  sortOrder   Int                     @default(0)
  version     Int                     @default(1)
  grants      ClearanceGrant[]
  rules       ClearanceTemplateRule[]
  steps       ClearanceStep[]
}

model ClearanceGrant {
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  departmentId String
  department   ClearanceDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  active       Boolean             @default(true)

  @@id([userId, departmentId])
  @@index([departmentId, active])
}

model ClearanceTemplate {
  id        String                  @id @default(cuid())
  name      String
  reason    ClearanceReason
  active    Boolean                 @default(true)
  version   Int                     @default(1)
  rules     ClearanceTemplateRule[]
  processes ClearanceProcess[]

  @@index([reason, active])
}

model ClearanceTemplateRule {
  templateId   String
  template     ClearanceTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  departmentId String
  department   ClearanceDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rule         ClearanceRule

  @@id([templateId, departmentId])
}

model ClearanceProcess {
  notificationEvents NotificationEvent[]
  id                   String             @id @default(cuid())
  number               String             @unique
  studentId            String
  student              User               @relation("ClearanceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  academicDepartmentId String
  academicDepartment   AcademicDepartment @relation(fields: [academicDepartmentId], references: [id], onDelete: Restrict)
  templateId           String
  template             ClearanceTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateName         String
  templateVersion      Int
  reason               ClearanceReason
  basisNote            String
  orderNumber          String?
  orderDate            DateTime?
  startsOn             DateTime
  plannedOn            DateTime?
  studentName          String
  groupName            String
  status               ClearanceStatus    @default(DRAFT)
  // Non-null only while active, including draft: portable unique reservation.
  activeKey            String?            @unique
  version              Int                @default(1)
  openedAt             DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  serviceRequestId     String?
  serviceRequest       ServiceRequest?    @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  steps                ClearanceStep[]
  history              ClearanceHistory[]
  document             ClearanceDocument?

  @@index([studentId, createdAt, id])
  @@index([academicDepartmentId, status, createdAt])
  @@index([status, reason, createdAt])
}

model ClearanceStep {
  id                 String              @id @default(cuid())
  processId          String
  process            ClearanceProcess    @relation(fields: [processId], references: [id], onDelete: Restrict)
  departmentId       String
  department         ClearanceDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name               String
  description        String
  contact            String
  sortOrder          Int
  rule               ClearanceRule
  isFinal            Boolean             @default(false)
  needsClarification Boolean             @default(false)
  applicabilityNote  String?
  status             ClearanceStepStatus @default(PENDING)
  decidedById        String?
  decidedByName      String?
  decidedAt          DateTime?
  remarks            ClearanceRemark[]
  history            ClearanceHistory[]

  @@unique([processId, departmentId])
  @@index([departmentId, status, processId])
}

model ClearanceRemark {
  id              String           @id @default(cuid())
  stepId          String
  step            ClearanceStep    @relation(fields: [stepId], references: [id], onDelete: Restrict)
  category        String
  description     String
  requiredAction  String
  contact         String
  dueOn           DateTime?
  amountMinor     Int?
  actorId         String
  actorName       String
  resolvedAt      DateTime?
  responsePending Boolean          @default(false)
  createdAt       DateTime         @default(now())
  replies         ClearanceReply[]

  @@index([stepId, resolvedAt])
}

model ClearanceReply {
  id        String          @id @default(cuid())
  remarkId  String
  remark    ClearanceRemark @relation(fields: [remarkId], references: [id], onDelete: Restrict)
  actorId   String
  actorName String
  text      String
  createdAt DateTime        @default(now())

  @@index([remarkId, createdAt])
}

// Append-only. Actor IDs and names are snapshots and survive account changes.
model ClearanceHistory {
  id             String            @id @default(cuid())
  processId      String?
  process        ClearanceProcess? @relation(fields: [processId], references: [id], onDelete: Restrict)
  stepId         String?
  step           ClearanceStep?    @relation(fields: [stepId], references: [id], onDelete: Restrict)
  actorId        String
  actorName      String
  action         String
  text           String
  studentVisible Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([processId, createdAt, id])
}

model ClearanceDocument {
  processId     String           @id
  process       ClearanceProcess @relation(fields: [processId], references: [id], onDelete: Restrict)
  snapshotJson  String
  content       Bytes
  sha256        String
  invalidatedAt DateTime?
  createdAt     DateTime         @default(now())
}

model ClearanceReceipt {
  actorId    String
  actor      User    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  key        String
  hash       String
  processId  String?
  resultJson String

  @@id([actorId, key])
}

model ClearanceWriteState {
  id      String @id
  version Int    @default(0)
}

enum ServiceStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CLARIFICATION_REQUIRED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model ServiceDefinition {
  code String
  version Int
  enabled Boolean @default(true)
  configJson String
  requests ServiceRequest[]
  @@id([code, version])
}

// Routing is explicit; an unconfigured service is visible but cannot be submitted.
model ServiceRoute {
  id String @id @default(cuid())
  serviceCode String
  sourceDepartmentId String
  source AcademicDepartment @relation("ServiceSource", fields: [sourceDepartmentId], references: [id], onDelete: Restrict)
  departmentId String
  department AcademicDepartment @relation("ServiceTarget", fields: [departmentId], references: [id], onDelete: Restrict)
  active Boolean @default(true)
  @@unique([serviceCode, sourceDepartmentId])
}

// Exactly one serviceCode or category must be set by the provisioning command.
model ServiceGrant {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  departmentId String
  department AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceCode String?
  category String?
  readFiles Boolean @default(false)
  readMilitary Boolean @default(false)
  active Boolean @default(true)
  @@index([userId, departmentId, active])
}

model ServiceRequest {
  dormPlacements DormPlacement[]
  issuedPass StudentPass?
  clearances ClearanceProcess[]
  id String @id @default(cuid())
  ownerId String
  owner User @relation("ServiceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  serviceCode String
  schemaVersion Int
  definition ServiceDefinition @relation(fields: [serviceCode, schemaVersion], references: [code, version], onDelete: Restrict)
  category String?
  departmentId String?
  department AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee User? @relation("ServiceAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  status ServiceStatus @default(DRAFT)
  version Int @default(1)
  fieldsJson String @default("{}")
  profileJson String?
  confirmationHash String?
  clarificationJson String?
  resultText String?
  completedBy String?
  submittedAt DateTime?
  completedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents ServiceDocument[]
  history ServiceHistory[]
  events ServiceEvent[]
  @@index([ownerId, deletedAt, createdAt])
  @@index([departmentId, status, createdAt])
  @@index([assigneeId, status])
}

model ServiceDocument {
  id String @id @default(cuid())
  requestId String
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  uploadedBy String
  kind String
  slot String
  name String
  key String @unique
  mime String
  size Int
  sha256 String
  removedAt DateTime?
  createdAt DateTime @default(now())
  @@index([requestId, removedAt])
}

// Append-only history; snapshots are private, never copied into application logs.
model ServiceHistory {
  id String @id @default(cuid())
  requestId String
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorId String
  actorName String
  action String
  text String?
  snapshotJson String?
  createdAt DateTime @default(now())
  @@index([requestId, createdAt, id])
}

// Addressed server events for the existing notifications UI (currently demo-only).
model ServiceEvent {
  id String @id @default(cuid())
  recipientId String
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  requestId String
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version Int
  type String
  createdAt DateTime @default(now())
  @@unique([requestId, version, type])
  @@index([recipientId, createdAt])
}

model ServiceReceipt {
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  key String
  hash String
  resultJson String
  @@id([actorId, key])
}

model ServiceWriteState {
  id String @id
  version Int @default(0)
}

model MilitaryRecord {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  departmentId String
  department AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  registrationStatus String?
  office String?
  documentType String?
  documentNumber String?
  verifiedAt DateTime?
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  TECHNICAL_STAFF
  ADMIN
  DEANERY_STAFF
}

model User {
  dormGrants DormGrant[]
  dormPlacements DormPlacement[]
  dormRepairsCreated DormRepair[] @relation("DormRepairAuthor")
  dormRepairsAssigned DormRepair[] @relation("DormRepairAssignee")
  dormDocuments DormDocument[]
  dormCharges DormCharge[]
  dormAudit DormAudit[]
  passGrant PassGrant?
  issuedPasses StudentPass[] @relation("PassIssuer")
  closedPasses StudentPass[] @relation("PassCloser")
  clearances ClearanceProcess[] @relation("ClearanceStudent")
  clearanceGrants ClearanceGrant[]
  clearanceReceipts ClearanceReceipt[]
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  image                 String?
  role                  Role                   @default(STUDENT)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  sessions              Session[]
  accounts              Account[]
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  technicalStaffProfile TechnicalStaffProfile?
  deaneryStaffProfile   DeaneryStaffProfile?
  scheduleAudits ScheduleAudit[]
  teachingAssignments TeachingAssignment[]
  brsResults BrsResult[] @relation("BrsStudent")
  brsAuthoredResults BrsResult[] @relation("BrsAuthor")
  brsAttendance BrsAttendance[] @relation("AttendanceStudent")
  brsAuthoredAttendance BrsAttendance[] @relation("AttendanceAuthor")
  brsAttempts BrsExamAttempt[] @relation("ExamStudent")
  brsAuthoredAttempts BrsExamAttempt[] @relation("ExamAuthor")
  brsAdmissions BrsAdmission[] @relation("AdmissionStudent")
  brsAdmissionDecisions BrsAdmission[] @relation("AdmissionAuthor")
  brsFinals BrsFinal[] @relation("FinalStudent")
  brsApprovedFinals BrsFinal[] @relation("FinalAuthor")
  brsAudits BrsAudit[]
  serviceRequests ServiceRequest[] @relation("ServiceOwner")
  serviceAssigned ServiceRequest[] @relation("ServiceAssignee")
  serviceGrants ServiceGrant[]
  serviceEvents ServiceEvent[]
  serviceReceipts ServiceReceipt[]
  militaryRecord MilitaryRecord?
  notifications Notification[]
  notificationSettings NotificationSettings?
  preferences UserPreferences?
  notificationAudits NotificationAudit[]
  materials LearningMaterial[]
  materialFolders MaterialFolder[]
  materialAudits MaterialAudit[]
  materialReceipts MaterialReceipt[]
}

// Presentation preferences only; no academic records or notification settings.
model UserPreferences {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboardLayoutJson String
  version Int @default(1)
  updatedAt DateTime @updatedAt
}

// Credentials belong to Better Auth's credential Account, never to a profile.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model StudentProfile {
  passes StudentPass[]
  userId        String      @id
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber String?     @unique
  institute     String?
  program       String?
  groupName     String?
  course        Int?
  studyMode     String?
  groupId       String?
  group         StudyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  lastName      String?
  firstName     String?
  middleName    String?
  gender        StudentGender?
  citizenship   String?
  contactPhone  String?
  educationLevel String?
  fundingBasis  String?
  enrolledAt    DateTime?
  expectedGraduationYear Int?
  educationStatus EducationStatus?
  personalFileNumber String?
  residenceStatus ResidenceStatus?
  dormitory     String?
  dormitoryRoom String?
  officialPhoto StudentOfficialPhoto?

  @@index([groupId])
}

enum PassStatus {
  ACTIVE
  REVOKED
  REPLACED
}

model PassGrant {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role
  canVerify Boolean @default(false)
  canManage Boolean @default(false)
  windowStart DateTime?
  checks Int @default(0)
}

model StudentPass {
  id Int @id @default(autoincrement())
  studentId String
  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  nonce String @unique
  tokenHash String @unique
  status PassStatus @default(ACTIVE)
  activeSlot Int? @default(1)
  issuedAt DateTime @default(now())
  issuedBy String
  issuer User @relation("PassIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)
  closedAt DateTime?
  closedBy String?
  closer User? @relation("PassCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  reason String?
  requestId String? @unique
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([studentId, activeSlot])
  @@index([studentId, id])
}

enum StudentGender {
  MALE
  FEMALE
}

// Null is unknown, never an assumed active enrolment.
enum EducationStatus {
  STUDYING
  ACADEMIC_LEAVE
  EXPELLED
  GRADUATED
  TRANSFERRED
}

enum ResidenceStatus {
  RESIDENT
  NON_RESIDENT
}

// Private binary data, outside public/ and Better Auth's user.image.
model StudentOfficialPhoto {
  userId String @id
  student StudentProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  content Bytes
  mimeType String
  updatedAt DateTime @default(now()) @updatedAt
}

model TeacherProfile {
  userId           String          @id
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String?
  position         String?
  scheduleSlug     String?         @unique
  publicName       String?
  isSchedulePublic Boolean         @default(false)
  lessons          LessonTeacher[]
}

model TechnicalStaffProfile {
  userId     String  @id
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?
  jobTitle   String?
}

model DeaneryStaffProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  position String?
  departments DeaneryDepartmentAssignment[]
}

model DeaneryDepartmentAssignment {
  userId String
  departmentId String
  staff DeaneryStaffProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  department AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([departmentId])
}

model News {
  dormResidents Boolean @default(false)
  dormTargets DormNewsTarget[]
  id          String   @id @default(cuid())
  title       String
  content     String
  publishedAt DateTime @default(now())
  category    String   @default("Объявления")
  isDemo      Boolean  @default(false)
  departmentId String?
  publicationKey String? @unique

  @@index([publishedAt])
}

// Events and addressed notifications are committed with the authoritative change.
// sourceKey is stable across retries; seq is the inbox high-water mark.
model NotificationEvent {
  dormRepairId String?
  dormRepair DormRepair? @relation(fields: [dormRepairId], references: [id], onDelete: Restrict)
  @@index([dormRepairId])
  @@index([clearanceProcessId])
  clearanceProcessId String?
  clearanceProcess ClearanceProcess? @relation(fields: [clearanceProcessId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  sourceKey String @unique
  source String
  sourceId String
  type String
  category String
  title String
  body String
  mandatory Boolean @default(false)
  createdAt DateTime @default(now())
  recipients Notification[]
}

model Notification {
  seq Int @id @default(autoincrement())
  eventId String
  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recipientId String
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientRole Role
  scopeGroupId String?
  scopeDepartmentId String?
  href String
  readAt DateTime?
  deliveries NotificationEmail[]
  @@unique([eventId, recipientId])
  @@index([recipientId, recipientRole, readAt, seq])
}

model NotificationSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionalCategoriesJson String @default("[\"STUDY\",\"SCHEDULE\",\"SERVICES\",\"ANNOUNCEMENTS\",\"SYSTEM\",\"MATERIALS\",\"DORMITORY\"]")
  emailCategoriesJson String @default("[]")
  personalEmail Boolean @default(false)
  updatedAt DateTime @updatedAt
}

// UNIVERSITY_EMAIL is reserved; only verified User.email can currently be used.
model NotificationEmail {
  id String @id @default(cuid())
  notificationSeq Int
  notification Notification @relation(fields: [notificationSeq], references: [seq], onDelete: Cascade)
  channel String @default("PERSONAL_EMAIL")
  state String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  sentAt DateTime?
  lastError String?
  @@unique([notificationSeq, channel])
  @@index([state, nextAttemptAt])
}

model NotificationAudit {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action String
  boundary Int?
  createdAt DateTime @default(now())
}

model NotificationWriteState {
  id String @id
  version Int @default(0)
}

enum LessonKind {
  LECTURE
  PRACTICE
  SEMINAR
  LAB
}

enum WeekPattern {
  EVERY
  NUMERATOR
  DENOMINATOR
}

model StudyGroup {
  materialTargets MaterialTarget[]
  id        String           @id @default(cuid())
  slug      String           @unique
  code      String           @unique
  programme String
  course    Int
  isPublic  Boolean          @default(false)
  students  StudentProfile[]
  lessons   LessonGroup[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  departmentId String?
  department AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parentId String?
  parent StudyGroup? @relation("Subgroups", fields: [parentId], references: [id], onDelete: SetNull)
  subgroups StudyGroup[] @relation("Subgroups")
  scheduleAudits ScheduleAuditGroup[]
  teachingAssignments TeachingAssignment[]
  brsPlans BrsPlan[]

  @@index([departmentId])
  @@index([parentId])
}

// Faculty is a category of departments; no separate faculty entity is needed yet.
model AcademicDepartment {
  clearances ClearanceProcess[]
  id String @id @default(cuid())
  faculty String
  name String
  groups StudyGroup[]
  deaneryAssignments DeaneryDepartmentAssignment[]
  serviceRequests ServiceRequest[]
  serviceGrants ServiceGrant[]
  serviceSourceRoutes ServiceRoute[] @relation("ServiceSource")
  serviceTargetRoutes ServiceRoute[] @relation("ServiceTarget")
  militaryRecords MilitaryRecord[]

  @@unique([faculty, name])
}

model Discipline {
  materials LearningMaterial[]
  materialFolders MaterialFolder[]
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  lessons   Lesson[]
  teachingAssignments TeachingAssignment[]
  brsPlans BrsPlan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Building {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isPublic Boolean @default(false)
  rooms    Room[]
}

model Room {
  id         String          @id @default(cuid())
  buildingId String
  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  number     String
  isPublic   Boolean         @default(false)
  entries    ScheduleEntry[]
  exceptions ScheduleException[]

  @@unique([buildingId, number])
}

// Dates are date-only values represented at UTC midnight. Local timetable times
// are minutes after midnight in the term's time zone, never browser-local times.
model AcademicTerm {
  materials LearningMaterial[]
  materialFolders MaterialFolder[]
  id                   String          @id @default(cuid())
  code                 String          @unique
  name                 String
  startsOn             DateTime
  endsOn               DateTime
  firstNumeratorMonday DateTime
  timeZone             String          @default("Europe/Moscow")
  isPublished          Boolean         @default(false)
  entries              ScheduleEntry[]
  exceptions ScheduleException[]
  teachingAssignments TeachingAssignment[]
  brsPlans BrsPlan[]
}

// Explicit academic authority, independent of timetable substitutions.
model TeachingAssignment {
  id String @id @default(cuid())
  teacherId String
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  groupId String
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  disciplineId String
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  termId String
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  confirmedAt DateTime @default(now())
  version Int @default(1)
  @@unique([teacherId, groupId, disciplineId, termId])
  @@index([groupId, termId])
}

enum BrsControl {
  CREDIT
  DIFFERENTIATED
  EXAM
  DISTRIBUTED
}

enum BrsEventKind {
  HOMEWORK
  LAB
  INTERIM
  FINAL
  SEMINAR
}

model BrsPlan {
  id String @id @default(cuid())
  groupId String
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  disciplineId String
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  termId String
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  control BrsControl
  templateVersion String
  revision Int @default(1)
  publishedAt DateTime?
  examOn DateTime?
  createdAt DateTime @default(now())
  modules BrsModule[]
  occurrences BrsOccurrence[]
  admissions BrsAdmission[]
  attempts BrsExamAttempt[]
  finals BrsFinal[]
  @@unique([groupId, disciplineId, termId])
}

model BrsModule {
  id String @id @default(cuid())
  planId String
  plan BrsPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  number Int
  startWeek Int
  endWeek Int
  seminarMax Int
  workMax Int
  controlMax Int
  state String @default("PLANNED")
  closedAt DateTime?
  events BrsEvent[]
  @@unique([planId, number])
}

// Stable identity is the source occurrence, so a move retains attendance/points.
model BrsOccurrence {
  id String @id @default(cuid())
  planId String
  plan BrsPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sourceKey String
  date DateTime
  startMinute Int
  endMinute Int
  kind String
  attendance BrsAttendance[]
  events BrsEvent[]
  @@unique([planId, sourceKey])
}

model BrsEvent {
  id String @id @default(cuid())
  moduleId String
  module BrsModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  kind BrsEventKind
  title String
  number Int
  week Int
  plannedOn DateTime?
  issuedOn DateTime?
  deadline DateTime?
  maxScore Int
  primaryMax Int?
  scaleVersion Int @default(1)
  scoringMode String @default("RATING")
  required Boolean @default(true)
  labMinScore Int?
  labRequiresDefense Boolean @default(true)
  occurrenceId String?
  occurrence BrsOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  results BrsResult[]
  @@index([moduleId])
}

model BrsResult {
  id String @id @default(cuid())
  eventId String
  event BrsEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentId String
  student User @relation("BrsStudent", fields: [studentId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("BrsAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  score Int?
  primaryScore Int?
  primaryMax Int?
  submissionTiming String?
  scoreSource String @default("HISTORICAL")
  exactNumerator String?
  exactDenominator String?
  passed Boolean?
  labStatus String?
  submittedOn DateTime?
  checkedOn DateTime?
  performedOn DateTime?
  defendedOn DateTime?
  comment String @default("")
  commentVisible Boolean @default(false)
  deleted Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, studentId])
  @@index([studentId])
}

model BrsAttendance {
  id String @id @default(cuid())
  occurrenceId String
  occurrence BrsOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  studentId String
  student User @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("AttendanceAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  mark String?
  version Int @default(1)
  @@unique([occurrenceId, studentId])
}

model BrsAdmission {
  id String @id @default(cuid())
  planId String
  plan BrsPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  studentId String
  student User @relation("AdmissionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("AdmissionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approved Boolean
  reason String
  decidedAt DateTime @default(now())
  basedRevision Int
  version Int @default(1)
  @@unique([planId, studentId])
}

model BrsExamAttempt {
  id String @id @default(cuid())
  planId String
  plan BrsPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  studentId String
  student User @relation("ExamStudent", fields: [studentId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("ExamAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  number Int
  score Int
  passed Boolean
  heldOn DateTime
  admissionVersion Int?
  comment String @default("")
  commentVisible Boolean @default(false)
  deleted Boolean @default(false)
  version Int @default(1)
  @@unique([planId, studentId, number])
}

// Immutable computed snapshot; later corrections mark it for explicit review.
model BrsFinal {
  id String @id @default(cuid())
  planId String
  plan BrsPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  studentId String
  student User @relation("FinalStudent", fields: [studentId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("FinalAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  score Int
  rating Int
  grade String
  basisJson String
  basedRevision Int
  approvedAt DateTime @default(now())
  needsReview Boolean @default(false)
  version Int @default(1)
  @@unique([planId, studentId])
}

model BrsAudit {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  planId String?
  objectId String
  action String
  requestId String
  commandHash String
  beforeJson String?
  afterJson String?
  reason String
  createdAt DateTime @default(now())
  @@unique([actorId, requestId])
  @@index([planId, createdAt])
}

model BrsWriteState {
  id String @id
  revision Int @default(0)
}

model Lesson {
  id           String          @id @default(cuid())
  disciplineId String
  discipline   Discipline      @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  kind         LessonKind
  groups       LessonGroup[]
  teachers     LessonTeacher[]
  entries      ScheduleEntry[]
  exceptions ScheduleException[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model LessonGroup {
  lessonId String
  groupId  String
  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([lessonId, groupId])
  @@index([groupId])
}

model LessonTeacher {
  lessonId  String
  teacherId String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Restrict)

  @@id([lessonId, teacherId])
  @@index([teacherId])
}

model ScheduleEntry {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  termId      String
  term        AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  roomId      String
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  weekPattern WeekPattern  @default(EVERY)
  isPublished Boolean      @default(false)
  isDeleted Boolean @default(false)
  version Int @default(1)
  exceptions ScheduleException[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([termId, isPublished, dayOfWeek, startMinute])
  @@index([lessonId])
  @@index([roomId])
}

// A full replacement snapshot for one source occurrence, or an additional pair
// when entryId is null. Inactive records are retained for audit/history.
model ScheduleException {
  id String @id @default(cuid())
  entryId String?
  entry ScheduleEntry? @relation(fields: [entryId], references: [id], onDelete: Restrict)
  sourceDate DateTime
  date DateTime
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  termId String
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startMinute Int
  endMinute Int
  isCancelled Boolean @default(false)
  isPublished Boolean @default(false)
  isActive Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, sourceDate])
  @@index([date, isActive])
  @@index([lessonId])
  @@index([termId])
  @@index([roomId])
}

model ScheduleWriteState {
  id String @id
  revision Int @default(0)
}

model ScheduleAudit {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  objectId String
  action String
  beforeJson String?
  afterJson String?
  groups ScheduleAuditGroup[]

  @@index([createdAt])
  @@index([objectId])
}

model ScheduleAuditGroup {
  auditId String
  groupId String
  audit ScheduleAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([auditId, groupId])
  @@index([groupId])
}

// Logical records and private physical blobs have separate lifecycles.
model MaterialFile {
  id String @id @default(cuid())
  key String @unique
  name String
  mime String
  size Int
  sha256 String
  createdAt DateTime @default(now())
  materials LearningMaterial[]
}

model LearningMaterial {
  id String @id @default(cuid())
  disciplineId String
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  termId String
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category String
  folderId String?
  folder MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  title String
  searchTitle String @default("")
  description String @default("")
  url String?
  fileId String?
  file MaterialFile? @relation(fields: [fileId], references: [id], onDelete: Restrict)
  status String @default("DRAFT")
  version Int @default(1)
  publishedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  targets MaterialTarget[]
  publications MaterialPublicationItem[]
  @@index([termId, disciplineId, status, deletedAt])
  @@index([authorId, folderId])
}

model MaterialTarget {
  materialId String
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  groupId String
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  @@id([materialId, groupId])
  @@index([groupId])
}

model MaterialFolder {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  disciplineId String
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  termId String
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  category String
  name String
  parentId String?
  parent MaterialFolder? @relation("MaterialTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MaterialFolder[] @relation("MaterialTree")
  materials LearningMaterial[]
  version Int @default(1)
  @@index([authorId, termId, disciplineId, category])
}

// A batch publication is one universal notification with current source scope.
model MaterialPublication {
  id String @id @default(cuid())
  items MaterialPublicationItem[]
}
model MaterialPublicationItem {
  publicationId String
  publication MaterialPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  materialId String
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  @@id([publicationId, materialId])
  @@index([materialId])
}
model MaterialReceipt {
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  key String
  hash String
  resultJson String
  @@id([actorId, key])
}
model MaterialAudit {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  objectId String
  createdAt DateTime @default(now())
  @@index([objectId, createdAt])
}
model MaterialWriteState {
  id String @id
  version Int @default(0)
}

enum DormPermission {
  FUND
  HOUSING
  REPAIR
  TECHNICIAN
  FINANCE
  DOCUMENTS
  ANNOUNCEMENTS
  GRANTS
}

enum DormPlacementStatus {
  RESERVED
  ACTIVE
  ENDED
  CANCELLED
  EXPIRED
}

enum DormRepairStatus {
  NEW
  ACCEPTED
  ASSIGNED
  IN_PROGRESS
  VERIFY
  CLOSED
  REWORK
  REJECTED
  CANCELLED
  MERGED
}

enum DormRepairCategory {
  ELECTRICITY
  PLUMBING
  FURNITURE
  APPLIANCE
  OTHER
}

enum DormDocumentKind {
  CONTRACT
  RULES
  INSTRUCTIONS
  RECEIPT
  OTHER
}

enum DormLedgerKind {
  PAYMENT
  ADJUSTMENT
}

model Dormitory {
  id String @id @default(cuid())
  name String @unique
  address String
  contacts String?
  archivedAt DateTime?
  buildings DormBuilding[]
  grants DormGrant[]
  documents DormDocument[]
  paymentUrl String?
  newsTargets DormNewsTarget[]
}

model DormBuilding {
  id String @id @default(cuid())
  dormitoryId String
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  name String @default("")
  floors DormFloor[]
  newsTargets DormNewsTarget[]
  @@unique([dormitoryId, name])
}

model DormFloor {
  id String @id @default(cuid())
  buildingId String
  building DormBuilding @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  number Int
  blocks DormBlock[]
  rooms DormRoom[]
  @@unique([buildingId, number])
}

model DormBlock {
  id String @id @default(cuid())
  floorId String
  floor DormFloor @relation(fields: [floorId], references: [id], onDelete: Restrict)
  name String
  rooms DormRoom[]
  @@unique([floorId, name])
}

model DormRoom {
  id String @id @default(cuid())
  floorId String
  floor DormFloor @relation(fields: [floorId], references: [id], onDelete: Restrict)
  blockId String?
  block DormBlock? @relation(fields: [blockId], references: [id], onDelete: Restrict)
  number String
  type String
  capacity Int
  available Boolean @default(true)
  archivedAt DateTime?
  notes String?
  beds DormBed[]
  repairs DormRepair[]
  inventory DormAsset[]
  @@unique([floorId, number])
  @@index([blockId])
}

model DormBed {
  id String @id @default(cuid())
  roomId String
  room DormRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  number Int
  available Boolean @default(true)
  archivedAt DateTime?
  placements DormPlacement[]
  @@unique([roomId, number])
}

model DormGrant {
  dormitoryId String
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission DormPermission
  active Boolean @default(true)
  @@id([dormitoryId, userId, permission])
  @@index([userId, active])
}

model DormPlacement {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  bedId String
  bed DormBed @relation(fields: [bedId], references: [id], onDelete: Restrict)
  serviceRequestId String?
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  previousId String?
  previous DormPlacement? @relation("DormTransfer", fields: [previousId], references: [id], onDelete: Restrict)
  transfers DormPlacement[] @relation("DormTransfer")
  status DormPlacementStatus
  reservedUntil DateTime
  startedAt DateTime?
  endsOn DateTime?
  endedAt DateTime?
  basis String
  createdAt DateTime @default(now())
  departure DormDeparture?
  loans DormLoan[]
  documents DormDocument[]
  charges DormCharge[]
  @@index([studentId, status, createdAt])
  @@index([bedId, status, reservedUntil])
  @@index([status, reservedUntil])
  @@index([serviceRequestId, status])
  @@index([previousId])
}

model DormRepair {
  id String @id @default(cuid())
  roomId String
  room DormRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("DormRepairAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee User? @relation("DormRepairAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  category DormRepairCategory
  title String
  signature String
  description String
  urgent Boolean @default(false)
  status DormRepairStatus @default(NEW)
  dueOn DateTime?
  version Int @default(0)
  mergedIntoId String?
  mergedInto DormRepair? @relation("DormRepairMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  duplicates DormRepair[] @relation("DormRepairMerge")
  events DormRepairEvent[]
  files DormFile[]
  notifications NotificationEvent[]
  createdAt DateTime @default(now())
  @@index([roomId, status, createdAt])
  @@index([assigneeId, status])
  @@index([mergedIntoId])
}

model DormRepairEvent {
  id String @id @default(cuid())
  repairId String
  repair DormRepair @relation(fields: [repairId], references: [id], onDelete: Restrict)
  auditId String @unique
  audit DormAudit @relation(fields: [auditId], references: [id], onDelete: Restrict)
  status DormRepairStatus
  message String?
  staffOnly Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([repairId, createdAt])
}

model DormFile {
  id String @id @default(cuid())
  key String @unique
  name String
  mime String
  size Int
  sha256 String
  repairId String?
  repair DormRepair? @relation(fields: [repairId], references: [id], onDelete: Restrict)
  document DormDocument?
  @@index([repairId])
}

model DormDocument {
  id String @id @default(cuid())
  dormitoryId String
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  placementId String?
  placement DormPlacement? @relation(fields: [placementId], references: [id], onDelete: Restrict)
  fileId String @unique
  file DormFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  kind DormDocumentKind
  title String
  archivedAt DateTime?
  createdAt DateTime @default(now())
  @@index([dormitoryId, ownerId, archivedAt])
  @@index([ownerId, archivedAt])
  @@index([placementId, kind])
}

model DormCharge {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  placementId String
  placement DormPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)
  basis String
  periodFrom DateTime
  periodTo DateTime
  amountRub String
  currency String @default("RUB")
  dueOn DateTime
  createdAt DateTime @default(now())
  entries DormLedgerEntry[]
  @@unique([placementId, periodFrom, periodTo, basis])
  @@index([studentId, dueOn])
}

model DormLedgerEntry {
  id String @id @default(cuid())
  chargeId String
  charge DormCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  auditId String @unique
  audit DormAudit @relation(fields: [auditId], references: [id], onDelete: Restrict)
  kind DormLedgerKind
  amountRub String
  reference String
  recordedAt DateTime @default(now())
  @@unique([chargeId, kind, reference])
}

model DormAsset {
  id String @id @default(cuid())
  roomId String
  room DormRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  label String
  condition String
  archivedAt DateTime?
  @@index([roomId, archivedAt])
}

model DormLoan {
  id String @id @default(cuid())
  placementId String
  placement DormPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)
  label String
  isKey Boolean
  issuedAt DateTime @default(now())
  returnedAt DateTime?
  condition String?
  @@index([placementId, returnedAt])
}

model DormDeparture {
  id String @id @default(cuid())
  placementId String @unique
  placement DormPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)
  reason String
  plannedOn DateTime
  inspectedAt DateTime?
  notes String?
  completedAt DateTime?
}

model DormAudit {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  requestKey String?
  commandHash String?
  action String
  targetId String
  detail String?
  createdAt DateTime @default(now())
  repairEvent DormRepairEvent?
  ledgerEntry DormLedgerEntry?
  @@unique([actorId, requestKey])
  @@index([targetId, createdAt])
}

model DormWriteState {
  id String @id
  version Int @default(0)
}

model DormNewsTarget {
  id String @id @default(cuid())
  newsId String
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  dormitoryId String
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  buildingId String?
  building DormBuilding? @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  @@index([newsId])
  @@index([dormitoryId, buildingId])
}
